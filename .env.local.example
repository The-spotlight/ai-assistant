# https://openrouter.ai/keys — used only on the server (never NEXT_PUBLIC_*)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: defaults to openrouter/free (rotates among available free models).
# You can also pin e.g. meta-llama/llama-3.2-3b-instruct:free
# OPENROUTER_MODEL=openrouter/free

# Optional: public URL of your app for OpenRouter rankings (defaults to localhost in dev)
# OPENROUTER_SITE_URL=https://example.com
