# PostgreSQL（Neon / Supabase 等），用于 Prisma。在控制台复制连接串，部署时同步到 Vercel Environment Variables。
# Neon 建议用带连接池的 URL（带 -pooler 或 Pooled connection）。
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# https://openrouter.ai/keys — used only on the server (never NEXT_PUBLIC_*)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional server default when the client does not send a whitelisted model id.
# The UI model picker sends the choice in the request body; this env is mainly for API/SSR overrides.
# OPENROUTER_MODEL=openrouter/free

# Optional: public URL of your app for OpenRouter rankings (defaults to localhost in dev)
# OPENROUTER_SITE_URL=https://example.com
