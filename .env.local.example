# PostgreSQL（Neon / Supabase 等），用于 Prisma。在控制台复制连接串，部署时同步到 Vercel Environment Variables。
# Neon 建议用带连接池的 URL（带 -pooler 或 Pooled connection）。
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# https://openrouter.ai/keys — used only on the server (never NEXT_PUBLIC_*)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: override model when request body omits or sends a non-whitelisted model id (e.g. API callers).
# OPENROUTER_MODEL=openrouter/free

# Optional: public URL of your app for OpenRouter rankings (defaults to localhost in dev)
# OPENROUTER_SITE_URL=https://example.com

# 加密密钥 - 用于"记住我"功能的 refresh token 加密存储
# 必须至少 32 个字符，生产环境请使用安全的随机字符串
ENCRYPTION_KEY=your-32-character-minimum-encryption-key-here

# 前端加密密钥（与 ENCRYPTION_KEY 相同或不同，用于浏览器端加密）
# 必须至少 32 个字符
NEXT_PUBLIC_ENCRYPTION_KEY=your-32-character-minimum-encryption-key-here
